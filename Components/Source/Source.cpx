from "../ImageSource/ImageSource.cpx" import { ImageSource }

export component Source {
    imageSource: ImageSource
    srcset?: string
    sizes?: string
    width?: integer
    height?: integer
    type?: string
    format?: string
    media?: string

    render <source
      srcset={srcset}
      sizes={sizes}
      width={width}
      height={height}
      type={format}
      format={format}
      media={media}
    />
}
